{{- $posts := where site.RegularPages "Section" "posts" -}}
{{- if not .IsHome -}}
  {{- $posts = where .RegularPages "Section" "posts" -}}
{{- end -}}
{{- $posts = $posts.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:dc="http://purl.org/dc/elements/1.1/">
  <channel>
    <title>{{ site.Title }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ site.Params.description }}</description>
    <language>{{ site.Language.Locale }}</language>
    {{ with $posts }}<lastBuildDate>{{ (index . 0).Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</lastBuildDate>{{ end }}
    {{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml" />{{ end }}
    {{ range $posts }}
    <item>
      <title>{{ .Title }}</title>
      {{ with .Params.authors }}
        {{ range . }}<dc:creator>{{ . }}</dc:creator>{{ end }}
      {{ else }}
        {{ with .Params.author }}<dc:creator>{{ . }}</dc:creator>{{ end }}
      {{ end }}
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ .Content | htmlEscape | safeHTML }}</description>
    </item>
    {{ end }}
  </channel>
</rss>
